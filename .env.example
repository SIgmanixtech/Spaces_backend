# Copy this file to .env and fill in real values. Never commit .env.
# Empty values are treated as "not set".

# --- Application ---
# development | test | production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# IANA zone used for calendar dates such as occupancy start/end. Timestamps are UTC.
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Database (Supabase PostgreSQL) ---
# Copy from Supabase dashboard > Connect. Percent-encode special characters
# in the password. Either postgresql:// or postgresql+psycopg:// is accepted.
#   Session pooler (recommended for local development, IPv4):
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct connection (IPv6 unless the IPv4 add-on is enabled):
#     postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   Transaction pooler (port 6543) also works; prepared statements are
#   disabled automatically for it.
DATABASE_URL=

# --- Supabase project ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Browser-safe key. Required for POST /auth/login and /auth/refresh.
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Required for Storage (uploads). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Private bucket holding property images and documents. Create it in the Supabase
# dashboard (Storage > New bucket) with "Public bucket" OFF.
PROPERTY_STORAGE_BUCKET=property-files
# supabase (needs SUPABASE_SECRET_KEY and the bucket) | local (a folder on this
# machine; development and tests only, never production).
STORAGE_BACKEND=supabase
# Used only when STORAGE_BACKEND=local. Defaults to backend/var/uploads (git-ignored).
LOCAL_STORAGE_DIR=
# Largest upload accepted, in megabytes.
MAX_UPLOAD_MB=10
# Most files one property, building, layout, space or asset may hold.
MAX_FILES_PER_OWNER=40

# --- Authentication (Supabase Auth access tokens) ---
SUPABASE_JWT_AUDIENCE=authenticated
# Only for projects still signing tokens with the legacy shared secret (HS256).
# Leave empty when the project uses asymmetric signing keys (verified via JWKS).
SUPABASE_JWT_SECRET=

# --- CORS ---
# Comma-separated list of exact frontend origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Tests only ---
# A separate, disposable PostgreSQL database. Must differ from DATABASE_URL.
TEST_DATABASE_URL=
